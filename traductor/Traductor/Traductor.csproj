<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Sin ventana ni consola visible: #414 CA1 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No mostramos ninguna ventana, pero SetWindowsHookEx entrega sus
         callbacks al hilo que instaló el hook a través de su cola de
         mensajes de Windows: sin un mensaje pump, el hook nunca dispara.
         Application.Run() es la forma estándar de bombear mensajes sin
         crear ningún Form. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Traductor</RootNamespace>
    <AssemblyName>Traductor</AssemblyName>

    <!-- Icono del ejecutable. Se usa la versión "-app" y no el .ico original
         de diseño porque aquel trae una sola imagen de 256x242: Windows la
         reduciría a 16x16 para el Administrador de tareas y, al no ser
         cuadrada, se vería estirada. La "-app" es el mismo arte centrado en
         lienzo cuadrado y exportado a 16/24/32/48/64/128/256. Si cambia el
         isotipo, se regenera desde el original (ver GUIA-DE-USO.md §7). -->
    <ApplicationIcon>..\..\assets\AIC-Isotipo-app.ico</ApplicationIcon>

    <!-- Lo que muestra el Administrador de tareas en la columna de nombre no
         es el nombre del archivo sino esta descripción. -->
    <AssemblyTitle>Traductor del gabinete</AssemblyTitle>
    <Product>Traductor del gabinete</Product>

    <!-- Autocontenido (sin instalar el runtime de .NET en cada gabinete):
         dotnet publish -c Release -r win-x64 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- A propósito NO se usa PublishSingleFile. Medido en una máquina con
         Smart App Control activo: el .exe de un solo archivo (154 MB) queda
         bloqueado siempre, y el mismo código publicado como carpeta corre sin
         problema. Un binario grande y sin firma que se autodescomprime al
         arrancar es exactamente el patrón de un packer de malware, y eso es lo
         que SAC rechaza — no la falta de firma en sí. El precio es repartir
         una carpeta en vez de un archivo suelto. Ver traductor/GUIA-DE-USO.md §3. -->
  </PropertyGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
